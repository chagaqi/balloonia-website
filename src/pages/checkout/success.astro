---
// Stripe sends the buyer here after paying. Clears the cart, waits for the webhook to
// write the order (usually 1-3 s), then shows the order number and what was bought.
import ShopLayout from '../../layouts/ShopLayout.astro';
---

<ShopLayout topic="Thank you" description="Your Balloonia Events order." noindex>
  <div class="s-thanks" data-thanks>
    <p class="s-product__eyebrow">Balloonia Events</p>
    <h1 class="s-h1" data-title>Thank you for your order</h1>
    <p data-lede>Payment received. We are confirming your order now.</p>
    <div class="s-thanks__panel" data-panel hidden></div>
    <p style="margin-top: 30px">
      <a class="s-button" href="/collections/all">Continue shopping</a>
    </p>
  </div>
</ShopLayout>

<script>
  import { clearCart } from '../../lib/shop/cart';
  import { money } from '../../lib/shop/price';

  type Status = {
    status: string;
    number?: number;
    firstName?: string | null;
    email?: string | null;
    deliveryMethod?: string | null;
    totals?: { subtotal: number; shipping: number; tax: number; discount: number; total: number };
    items?: { title: string; variantTitle: string | null; quantity: number; lineTotal: number; selections: { label: string; value: string }[] }[];
  };

  const esc = (s: string) => s.replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[c] as string);
  const sessionId = new URLSearchParams(location.search).get('session_id') || '';
  const title = document.querySelector<HTMLElement>('[data-title]')!;
  const lede = document.querySelector<HTMLElement>('[data-lede]')!;
  const panel = document.querySelector<HTMLElement>('[data-panel]')!;

  if (sessionId) clearCart();

  function render(o: Status) {
    title.textContent = `Order #${o.number} confirmed`;
    const pickup = o.deliveryMethod === 'pickup';
    const sentTo = o.email ? ` A confirmation is on its way to <strong>${esc(o.email)}</strong>.` : '';
    lede.innerHTML = pickup
      ? `Thanks${o.firstName ? `, ${esc(o.firstName)}` : ''}.${sentTo} Please reply to that email with a day and time that works for you to pick up your order at 412 Newbold St, Unit 4, London. We are open Monday to Friday 9 to 6, and Saturday 11 to 6.`
      : `Thanks${o.firstName ? `, ${esc(o.firstName)}` : ''}. We will text you within 24 hours to confirm your delivery window.${sentTo}`;
    const t = o.totals!;
    panel.innerHTML =
      (o.items || [])
        .map(
          (i) => `<div class="s-thanks__line"><div><strong>${esc(i.title)}</strong> × ${i.quantity}<div class="s-thanks__props">${[
            i.variantTitle ? esc(i.variantTitle) : '',
            ...i.selections.map((s) => `${esc(s.label)}: ${esc(s.value)}`),
          ]
            .filter(Boolean)
            .join('<br>')}</div></div><div>${money(i.lineTotal)}</div></div>`,
        )
        .join('') +
      `<div class="s-thanks__totals">
        <div><span>Subtotal</span><span>${money(t.subtotal)}</span></div>
        ${t.discount > 0 ? `<div><span>Discount</span><span>- ${money(t.discount)}</span></div>` : ''}
        <div><span>${pickup ? 'Pickup' : 'Delivery'}</span><span>${t.shipping > 0 ? money(t.shipping) : 'Free'}</span></div>
        <div><span>HST</span><span>${money(t.tax)}</span></div>
        <div><span>Total</span><span>${money(t.total)} CAD</span></div>
      </div>`;
    panel.hidden = false;
    const w = window as unknown as { gtag?: (...a: unknown[]) => void };
    w.gtag?.('event', 'purchase', {
      transaction_id: String(o.number),
      currency: 'CAD',
      value: t.total,
      tax: t.tax,
      shipping: t.shipping,
      items: (o.items || []).map((i) => ({ item_name: i.title, quantity: i.quantity, price: i.lineTotal / i.quantity })),
    });
  }

  async function poll(attempt = 0) {
    if (!sessionId) {
      lede.textContent = 'If you just placed an order, your confirmation email is on its way.';
      return;
    }
    try {
      const res = await fetch(`/api/order-status?session_id=${encodeURIComponent(sessionId)}`);
      const data = (await res.json()) as Status;
      if (res.ok && data.number) return render(data);
    } catch {
      /* retry */
    }
    if (attempt < 20) window.setTimeout(() => poll(attempt + 1), attempt < 5 ? 1000 : 3000);
    else lede.textContent = 'Payment received. Your confirmation email will arrive shortly. Questions? Text 226-242-2244.';
  }
  poll();
</script>
