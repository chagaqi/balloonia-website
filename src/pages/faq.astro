---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import FAQAccordion from '../components/FAQAccordion.astro';
import CTAButton from '../components/CTAButton.astro';
import { faqPageSchema } from '../lib/schema/faqPage';

// The FAQ page is the canonical home for every entry in the collection.
// Other pages filter by `pages`; this one deliberately does not, so a new
// FAQ file shows up here automatically without touching this route.
const faqs = (await getCollection('faq'))
  .sort((a, b) => a.data.order - b.data.order)
  .map((f) => ({ question: f.data.question, body: f.body.trim() }));

// Same array feeds the visible accordion and the JSON-LD. Google devalues
// FAQPage markup that does not match on-page text, so they must not drift.
const schemas = [faqPageSchema(faqs.map((f) => ({ question: f.question, answer: f.body })))];
---

<BaseLayout
  topic="Balloon Decor FAQ"
  description="Answers on balloon arch and garland pricing in London Ontario, how long balloons last, booking lead times, outdoor installs, setup and venue coordination."
  breadcrumbs={[
    { name: 'Home', url: '/' },
    { name: 'FAQ', url: '/faq' },
  ]}
  schemas={schemas}
>
  <section class="faq-hero section">
    <div class="container container-narrow">
      <p class="eyebrow">Questions</p>
      <h1>Balloon decor questions, answered straight.</h1>
      <p class="lede">
        Real pricing ranges, real timelines, and what actually changes the number. If your question is
        not here, message us and we will answer it directly.
      </p>
    </div>
  </section>

  <FAQAccordion faqs={faqs} />

  <section class="cta-strip section">
    <div class="container container-narrow text-center">
      <h2>Still deciding?</h2>
      <p class="lede">
        Send your date, venue, and colours. Brenda quotes within 24 hours, and there is no cost to ask.
      </p>
      <div class="cta-buttons">
        <CTAButton href="/quote" variant="primary" size="lg">Get a quote</CTAButton>
        <CTAButton href="/services" variant="secondary" size="lg">Browse services</CTAButton>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .faq-hero h1 {
    margin-top: var(--space-3);
    margin-bottom: var(--space-5);
  }
  .faq-hero .lede {
    max-width: 60ch;
  }
  .text-center {
    text-align: center;
  }
  .text-center p {
    margin-left: auto;
    margin-right: auto;
  }
  .cta-buttons {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    justify-content: center;
    margin-top: var(--space-6);
  }
  .cta-strip {
    background: var(--color-paper-soft);
  }
</style>
