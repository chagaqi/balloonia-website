---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Hero from '../../components/Hero.astro';
import ProductGrid from '../../components/ProductGrid.astro';
import FAQAccordion from '../../components/FAQAccordion.astro';
import QuoteForm from '../../components/quote/QuoteForm.tsx';
import { serviceSchema } from '../../lib/schema/service';
import { faqPageSchema } from '../../lib/schema/faqPage';
import { getAllProducts } from '../../data/catalog/shopify';
import '../../styles/quote-form.css';

const allProducts = await getAllProducts();
const products = allProducts.filter((p) => p.tags.includes('garland')).slice(0, 9);

const faqs = (await getCollection('faq'))
  .filter((f) => f.data.pages.includes('garlands'))
  .sort((a, b) => a.data.order - b.data.order)
  .map((f) => ({ question: f.data.question, body: f.body.trim() }));

const schemas = [
  serviceSchema({
    name: 'Balloon garlands',
    description:
      'Custom organic balloon garlands built to length and colour palette, delivered and installed for events in London Ontario.',
    startingPrice: 160,
    url: '/services/balloon-garlands',
  }),
];
if (faqs.length > 0) {
  schemas.push(faqPageSchema(faqs.map((f) => ({ question: f.question, answer: f.body }))));
}
---

<BaseLayout
  topic="Balloon Garlands"
  description="Custom balloon garlands in London Ontario. Built to your length, colours, and surface, then delivered and installed. Accent garlands from $160, full feature walls to $1,200."
  breadcrumbs={[
    { name: 'Home', url: '/' },
    { name: 'Services', url: '/services' },
    { name: 'Balloon garlands', url: '/services/balloon-garlands' },
  ]}
  schemas={schemas}
>
  <Hero
    eyebrow="Install type"
    headline="Balloon garlands in London, Ontario"
    subhead="Organic garlands built to your length and palette. Wrapped along rails, draped across head tables, climbing a feature wall."
    primaryCta={{ href: '/quote', label: 'Start a quote' }}
    secondaryCta={{ href: '/portfolio', label: 'See garland work' }}
    image="/images/categories/SpringFloralBalloonGarland.webp"
    imageAlt="Spring floral balloon garland in soft pastel tones"
    variant="page"
  />

  <section class="install-body section">
    <div class="container container-narrow prose">
      <p>
        A garland works as a single accent piece or as the structural base for something much larger.
        Wrapped along stair rails, draped across head tables, anchored to backdrops, run up a corner and
        across a ceiling line. It is the most adaptable thing we build, because it takes the shape of
        whatever surface it is going on.
      </p>
      <p>
        Small accent garlands for a table run or a dessert display start around $160. A standard eight
        to twelve foot garland for a shower, birthday, or office event runs $200 to $500. Large organic
        garlands covering a staircase or a full feature wall land between $700 and $1,200.
      </p>
      <p>
        Three things move that number. Length is the obvious one. Colour count matters more than people
        expect, since every added colour is a separate inflation batch and a separate sort before the
        build starts. And the surface decides the method, because brick, glass, and anything a venue will
        not let us drill into all need a different approach. The
        <a href="/faq">FAQ</a> goes deeper on pricing and on how long garlands hold up outdoors.
      </p>
      <p>
        Need something that frames a doorway or a ceremony instead? That is a
        <a href="/services/balloon-arches">balloon arch</a>.
      </p>
    </div>
  </section>

  {products.length > 0 && (
    <section class="install-products section">
      <div class="container">
        <header class="section-head">
          <p class="eyebrow">Shop the catalog</p>
          <h2>Balloon garlands in the catalog</h2>
          <p class="lede">Pick a build as-is or use one as the starting point for a custom version.</p>
        </header>
        <ProductGrid products={products} columns={3} />
        <p class="section-link-wrap">
          <a class="section-link" href="https://shop.balloonia.events/collections/arches-garlands">View all garlands →</a>
        </p>
      </div>
    </section>
  )}

  {faqs.length > 0 && <FAQAccordion heading="Balloon garland questions" faqs={faqs} />}

  <section class="install-quote section">
    <div class="container">
      <header class="section-head">
        <p class="eyebrow">Custom build</p>
        <h2>Need something specific?</h2>
        <p class="lede">Send the wall or table you want covered, your colours, and your date.</p>
      </header>
      <QuoteForm client:load />
    </div>
  </section>
</BaseLayout>

<style>
  .prose p {
    color: var(--color-ink-soft);
    font-size: var(--font-size-lg);
    line-height: var(--line-relaxed);
  }
  .prose a {
    color: var(--color-accent-deep);
    text-decoration: underline;
    text-underline-offset: 4px;
  }
  .section-head {
    margin-bottom: var(--space-6);
  }
  .install-quote {
    background: var(--color-paper-soft);
  }
  .section-link {
    color: var(--color-accent-deep);
    font-size: var(--font-size-sm);
    font-weight: 500;
    text-decoration: underline;
    text-underline-offset: 4px;
  }
  .section-link-wrap {
    margin-top: var(--space-5);
  }
</style>
