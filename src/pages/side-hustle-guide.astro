---
// Lead-magnet opt-in page, offer-stack style: centered single column, headline,
// form up top, deliverable as a concrete checklist, practitioner block, form again.
// Copy edits flow through the editable artifact DH works in; keep section shapes stable.
import LPBase from '../layouts/LPBase.astro';

const title = 'Balloon Side Hustle Starter Guide (Free) | Balloonia Events';
const description =
  'Free guide from a working balloon studio: the full starter kit list, your first 10 customers in 4 weeks, pricing that holds, and three paths to scale past a side hustle.';
---

<LPBase title={title} description={description} canonical="https://balloonia.events/side-hustle-guide" ogImage="/images/categories/arches-garlands.webp">
  <main class="magnet">
    <p class="magnet-brand">Balloonia Events</p>

    <!-- Hero -->
    <section class="magnet-hero">
      <div class="magnet-col">
        <p class="magnet-eyebrow">Free guide from a working studio</p>
        <h1>Make an extra $1000 this month selling bespoke balloon decor</h1>
        <p class="magnet-sub">
          A complete guide on how to start your own balloon decor business from scratch. Even with
          a full time job and kids!
        </p>

        <form class="magnet-form" data-guide-form>
          <label class="sr-only" for="email-hero">Email address</label>
          <input id="email-hero" type="email" name="email" placeholder="Your email" required autocomplete="email" />
          <input type="text" name="website" tabindex="-1" autocomplete="off" class="hp" aria-hidden="true" />
          <button type="submit">Get the free guide</button>
        </form>
        <p class="magnet-micro">Instant access, plus a copy in your inbox.</p>
        <p class="magnet-error" data-form-error hidden>That did not go through. Try again, or email contact@balloonia.events and we will send it by hand.</p>
      </div>
    </section>

    <!-- The stack -->
    <section class="magnet-stack">
      <div class="magnet-col">
        <h2>Inside the guide</h2>
        <ul class="stack-list">
          <li>
            <span class="stack-check" aria-hidden="true">✓</span>
            <div>
              <strong>Full starter kit line item list. No guesswork.</strong>
              <p>Everything you need to get started. Where to source everything and what is considered a good deal on things you can find used on a budget.</p>
            </div>
          </li>
          <li>
            <span class="stack-check" aria-hidden="true">✓</span>
            <div>
              <strong>A-Z Blueprint and where to advertise your business</strong>
              <p>How to get your first 10 customers in the first 4 weeks.</p>
            </div>
          </li>
          <li>
            <span class="stack-check" aria-hidden="true">✓</span>
            <div>
              <strong>How to become skilled at balloon art</strong>
              <p>Recommended builds to start with and how to build them. Plus more on furthering your skillset.</p>
            </div>
          </li>
          <li>
            <span class="stack-check" aria-hidden="true">✓</span>
            <div>
              <strong>How to set your business up for success</strong>
              <p>A simple framework to get return customers and spread the word fast. A proven framework to dominate in your local niche.</p>
            </div>
          </li>
          <li>
            <span class="stack-check" aria-hidden="true">✓</span>
            <div>
              <strong>Tips and tricks of the trade from an experienced balloon artist</strong>
              <p>Key things we have learned along the way. What to avoid like the plague, what to double down on, and how to keep momentum once you hit traction.</p>
            </div>
          </li>
          <li>
            <span class="stack-check" aria-hidden="true">✓</span>
            <div>
              <strong>How to scale your side hustle into a gig that outpaces your day job</strong>
              <p>3 different paths you can take to scale your business beyond a side hustle.</p>
            </div>
          </li>
        </ul>
      </div>
    </section>

    <!-- Practitioner block -->
    <section class="magnet-who">
      <div class="magnet-col">
        <h2>Who's behind this</h2>
        <p>
          Balloonia Events is a custom balloon studio in Canada. Brenda, a formally trained
          artist, builds everything here from $50 bouquets to $5,000 corporate installations.
          If a figure is in the guide, we have charged it or paid it. You're getting the notes
          we'd hand to ourselves if we had to start over from day 1.
        </p>
      </div>
    </section>

    <!-- FAQ -->
    <section class="magnet-faq">
      <div class="magnet-col">
        <h2>Quick questions</h2>
        <details>
          <summary>What can I honestly expect to earn?</summary>
          <p>At our studio a standard garland sells for $200 to $500, and materials in a $300 garland run $40 to $60. What you actually earn depends on your prices and how many jobs you take. The guide shows the math so you can run it for your own city.</p>
        </details>
        <details>
          <summary>I already have a job. Where do the hours come from?</summary>
          <p>A $300 garland takes us 1 to 2 hours all-in, including transport and quoting. One build fits in a Saturday morning. You can take one job at a time and stop there, or add more when a weekend opens up.</p>
        </details>
        <details>
          <summary>I've never built anything like this. Can I learn it?</summary>
          <p>Garlands are the starting point because they forgive mistakes. Cluster sizes repeat, and small errors hide inside the shape. The guide orders your first three builds so each one teaches the next: garland, then arch, then backdrop.</p>
        </details>
        <details>
          <summary>Isn't this market already crowded?</summary>
          <p>We can't speak for your city. Here's what happened in ours. When we offered a styled-shoot trade with photographers, more than a dozen said yes within a week. The guide gives you three $0 ways to test demand where you live.</p>
        </details>
        <details>
          <summary>What does it cost, and what happens after I sign up?</summary>
          <p>The guide is free. Enter your email and it opens right away, with a copy sent to your inbox. It prints clean to PDF if you want it on paper. We're a working studio, so expect the occasional email about building and selling balloon work. Leave any time.</p>
        </details>
      </div>
    </section>

    <!-- Final CTA -->
    <section class="magnet-final">
      <div class="magnet-col">
        <h2>Your first paid balloon gig is waiting!</h2>
        <p>Read the guide tonight, and next Saturday could be kit on the table, first garland on your own wall, photo taken.</p>
        <form class="magnet-form" data-guide-form>
          <label class="sr-only" for="email-final">Email address</label>
          <input id="email-final" type="email" name="email" placeholder="Your email" required autocomplete="email" />
          <input type="text" name="website" tabindex="-1" autocomplete="off" class="hp" aria-hidden="true" />
          <button type="submit">Get the free guide</button>
        </form>
        <p class="magnet-micro">Free, a 12-minute read, yours right after the email.</p>
        <p class="magnet-error" data-form-error hidden>That did not go through. Try again, or email contact@balloonia.events and we will send it by hand.</p>
      </div>
    </section>

    <footer class="magnet-footer">
      <p>Balloonia Events · London, Canada · <a href="https://balloonia.events">balloonia.events</a></p>
    </footer>
  </main>

  <script>
    const forms = document.querySelectorAll('[data-guide-form]');
    forms.forEach((form, i) => {
      form.addEventListener('submit', async (e) => {
        e.preventDefault();
        const f = e.currentTarget as HTMLFormElement;
        const errEl = f.parentElement?.querySelector('[data-form-error]');
        const btn = f.querySelector('button');
        const email = (f.querySelector('input[name="email"]') as HTMLInputElement).value;
        const website = (f.querySelector('input[name="website"]') as HTMLInputElement).value;
        errEl?.setAttribute('hidden', '');
        if (btn) {
          btn.disabled = true;
          btn.textContent = 'Sending…';
        }
        try {
          const res = await fetch('/api/guide', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ email, website, source: i === 0 ? 'side-hustle-lp-hero' : 'side-hustle-lp-final' }),
          });
          if (!res.ok) throw new Error('bad status');
          window.location.href = '/side-hustle-guide/thanks';
        } catch {
          errEl?.removeAttribute('hidden');
          if (btn) {
            btn.disabled = false;
            btn.textContent = 'Send me the free guide';
          }
        }
      });
    });
  </script>

  <style>
    .magnet {
      font-family: 'Inter', -apple-system, sans-serif;
      color: #191817;
      background: #ffffff;
      min-height: 100vh;
    }
    .magnet-col {
      max-width: 40rem;
      margin: 0 auto;
      padding: 0 1.25rem;
    }
    .sr-only {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip: rect(0 0 0 0);
    }
    .hp {
      position: absolute;
      left: -9999px;
      height: 1px;
      width: 1px;
      opacity: 0;
    }

    .magnet-brand {
      text-align: center;
      font-size: 0.85rem;
      font-weight: 600;
      letter-spacing: 0.1em;
      text-transform: uppercase;
      color: #8a877f;
      padding: 1.75rem 0 0;
      margin: 0;
    }

    .magnet-hero {
      padding: 2.5rem 0 3rem;
      text-align: center;
    }
    .magnet-eyebrow {
      display: inline-block;
      font-size: 0.8rem;
      font-weight: 600;
      letter-spacing: 0.06em;
      text-transform: uppercase;
      color: #1c3d34;
      background: #eef4f0;
      border-radius: 999px;
      padding: 0.35rem 0.9rem;
      margin: 0 0 1.25rem;
    }
    .magnet h1 {
      font-size: clamp(2.1rem, 6vw, 3.3rem);
      line-height: 1.08;
      margin: 0 0 1.1rem;
      font-weight: 800;
      letter-spacing: -0.025em;
    }
    .magnet-sub {
      font-size: 1.12rem;
      line-height: 1.65;
      color: #4b4a45;
      margin: 0 auto 1.75rem;
      max-width: 34rem;
    }

    .magnet-form {
      display: flex;
      flex-wrap: wrap;
      gap: 0.6rem;
      justify-content: center;
      max-width: 30rem;
      margin: 0 auto;
    }
    .magnet-form input[type='email'] {
      flex: 1 1 15rem;
      padding: 0.95rem 1.1rem;
      font-size: 1rem;
      border: 1.5px solid #d9d2c5;
      border-radius: 0.65rem;
      background: #fff;
    }
    .magnet-form input[type='email']:focus {
      outline: 2px solid #1c3d34;
      border-color: #1c3d34;
    }
    .magnet-form button {
      padding: 0.95rem 1.6rem;
      font-size: 1rem;
      font-weight: 700;
      color: #fff;
      background: #1c3d34;
      border-radius: 0.65rem;
      transition: background 0.15s ease;
    }
    .magnet-form button:hover {
      background: #142c26;
    }
    .magnet-form button:disabled {
      opacity: 0.7;
      cursor: wait;
    }
    .magnet-micro {
      font-size: 0.85rem;
      color: #8a877f;
      margin: 0.7rem 0 0;
      text-align: center;
    }
    .magnet-error {
      color: #a33;
      font-size: 0.9rem;
      margin-top: 0.5rem;
      text-align: center;
    }

    .magnet h2 {
      font-size: clamp(1.4rem, 3.5vw, 1.8rem);
      margin: 0 0 1.5rem;
      letter-spacing: -0.01em;
      text-align: center;
    }

    .magnet-stack {
      padding: 2.75rem 0;
      background: #faf7f2;
      border-top: 1px solid #eee7da;
      border-bottom: 1px solid #eee7da;
    }
    .stack-list {
      list-style: none;
      margin: 0;
      padding: 0;
      display: flex;
      flex-direction: column;
      gap: 1.1rem;
    }
    .stack-list li {
      display: flex;
      gap: 0.9rem;
      align-items: flex-start;
      background: #fff;
      border: 1px solid #eee7da;
      border-radius: 0.8rem;
      padding: 1.1rem 1.25rem;
    }
    .stack-check {
      flex: 0 0 auto;
      width: 1.5rem;
      height: 1.5rem;
      border-radius: 50%;
      background: #1c3d34;
      color: #fff;
      font-size: 0.85rem;
      font-weight: 700;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      margin-top: 0.1rem;
    }
    .stack-list strong {
      display: block;
      margin-bottom: 0.25rem;
      font-size: 1.02rem;
    }
    .stack-list p {
      margin: 0;
      color: #4b4a45;
      font-size: 0.95rem;
      line-height: 1.55;
    }

    .magnet-who {
      padding: 2.75rem 0;
    }
    .magnet-who p {
      color: #4b4a45;
      line-height: 1.65;
      text-align: center;
      max-width: 36rem;
      margin: 0 auto;
    }

    .magnet-faq {
      padding: 0 0 2.75rem;
    }
    .magnet-faq details {
      border-bottom: 1px solid #e5ddcf;
      padding: 0.9rem 0;
    }
    .magnet-faq summary {
      font-weight: 600;
      cursor: pointer;
    }
    .magnet-faq p {
      color: #4b4a45;
      margin: 0.6rem 0 0;
      line-height: 1.55;
    }

    .magnet-final {
      padding: 3rem 0 3.5rem;
      text-align: center;
      background: #faf7f2;
      border-top: 1px solid #eee7da;
    }
    .magnet-final > .magnet-col > p:not(.magnet-micro):not(.magnet-error) {
      color: #4b4a45;
      margin: 0 0 1.5rem;
    }

    .magnet-footer {
      padding: 1.5rem 1.25rem;
      font-size: 0.85rem;
      color: #8a877f;
      text-align: center;
      border-top: 1px solid #e5ddcf;
    }
    .magnet-footer p {
      margin: 0;
    }
    .magnet-footer a {
      text-decoration: underline;
      text-underline-offset: 3px;
    }
  </style>
</LPBase>
