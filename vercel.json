{
  "headers": [
    {
      "source": "/downloads/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "shop.balloonia.events"
        }
      ],
      "destination": "https://balloonia.events/",
      "statusCode": 301
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "shop.balloonia.events"
        }
      ],
      "destination": "https://balloonia.events/:path*",
      "statusCode": 301
    },
    {
      "source": "/products/luxury-valentines-day-balloons",
      "destination": "/collections/all",
      "permanent": true
    },
    {
      "source": "/products/valentines-day-balloon-installation",
      "destination": "/collections/all",
      "permanent": true
    },
    {
      "source": "/products/corporative-christmas-decor-setup",
      "destination": "/collections/all",
      "permanent": true
    },
    {
      "source": "/products/modern-organic-balloon-arch-display",
      "destination": "/collections/all",
      "permanent": true
    }
  ],
  "crons": [
    {
      "path": "/api/shop-keepalive",
      "schedule": "0 13 * * *"
    }
  ]
}
